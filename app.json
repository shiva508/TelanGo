{
  "expo": {
    "name": "TelanGo",
    "slug": "TelanGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconBackUp.png",
    "scheme": "telango",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foregroundBackUp.png",
        "backgroundImage": "./assets/images/android-icon-backgroundBackUp.png",
        "monochromeImage": "./assets/images/android-icon-monochromeBackUp.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.studentpool.TelanGo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/faviconBackUp.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-iconBackUp.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1cd57b93-2970-4641-8df9-39e3edd119d7"
      }
    }
  }
}
